{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "238056",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "dde8e767-8e2c-482f-8610-e26b29d23038","database_name": "nova-e3a661-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1ccab21048554ec49b1d24ccdc3e6ab8" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
